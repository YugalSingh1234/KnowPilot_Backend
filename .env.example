# Postgres connection string, psycopg 3 driver: postgresql+psycopg://...
# Long-running server (Render): Session pooler, port 5432. Serverless (Vercel): Transaction pooler, port 6543.
DATABASE_URL=
# Supabase project URL
SUPABASE_URL=
# Supabase secret key (server only, never expose to the frontend)
SUPABASE_SECRET_KEY=
# Private Supabase Storage bucket holding the uploaded PDFs
SUPABASE_BUCKET=documents
# Google Gemini API key
GEMINI_API_KEY=
# Gemini chat/generation model name
GEMINI_CHAT_MODEL=
# Gemini embedding model name
GEMINI_EMBED_MODEL=
# Embedding vector dimension (must match the pgvector column)
EMBED_DIM=768
# Secret used to sign admin JWTs
JWT_SECRET=
# JWT lifetime in minutes
JWT_EXPIRE_MINUTES=720
# Frontend origin(s) allowed by CORS; comma-separated for several
FRONTEND_ORIGIN=http://localhost:5173
# Public base URL used to build assistant links and embed codes
PUBLIC_APP_URL=http://localhost:5173
# Minimum retrieval similarity for the answerability gate
GATE_MIN_SIMILARITY=0.60
# Lower similarity accepted when the question also matches a keyword in the documents
GATE_KEYWORD_MIN_SIMILARITY=0.55
